{
  "name": "spanglish",
  "private": true,
  "packageManager": "pnpm@9.7.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "supabase": "supabase",
    "db:types": "supabase gen types typescript --local --schema public > packages/db/src/database.types.ts",
    "db:link": "supabase link --project-ref",
    "db:push:dry": "supabase db push --dry-run",
    "db:push": "supabase db push",
    "db:remote:types": "supabase gen types typescript --linked --schema public"
  },
  "devDependencies": {
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
