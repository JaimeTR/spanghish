# Copiar a .env.local en cada app. NUNCA subir valores reales.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL pública de la app (p. ej. http://127.0.0.1:3001 en local). Base de los enlaces de
# recuperación de contraseña: nunca se usa la cabecera Host.
NEXT_PUBLIC_SITE_URL=
# URL del portal de alumnos (apps/app) para el enlace "Entrar" de apps/web.
# Por defecto https://app.spanglish.com.au.
NEXT_PUBLIC_APP_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Contenido publicado en la web (apps/web lee docentes, recursos y lecciones con las dos
# NEXT_PUBLIC_SUPABASE_* de arriba; sin ellas usa su respaldo estático). Para que un cambio
# de la administración se vea al momento (si no, en 5 minutos como mucho):
# - en apps/app: WEB_REVALIDATE_URL = https://<web>/api/revalidate
# - en apps/app y apps/web: WEB_REVALIDATE_SECRET, el mismo valor, de 32 caracteres o más.
WEB_REVALIDATE_URL=
WEB_REVALIDATE_SECRET=
# Tienda de apps/web (/shop): clave secreta de Stripe (sk_test_... en local) y secreto del
# webhook (whsec_..., lo da `stripe listen` o el panel de Stripe). Sin la clave, "Ir a pagar"
# avisa de que los pagos no están activos; sin el secreto, el webhook responde 400.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Solicitudes de clase gratis de apps/web (/bookings). Sin las tres, en desarrollo se
# escriben en la consola y en producción el formulario avisa de que no está disponible.
RESEND_API_KEY=
# Destinatario(s) de las solicitudes (separados por comas) y remitente verificado en Resend.
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=

# Web de demostracion: 1 = fuera de buscadores (robots.txt y X-Robots-Tag). No definir en produccion real.
SITE_NOINDEX=
